<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Poné acá la versión de .NET que tengas instalada (mirá con: dotnet --version).
         Si ves 8.x poné net8.0, si ves 9.x poné net9.0, si ves 10.x poné net10.0. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


</Project>
